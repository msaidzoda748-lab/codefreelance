# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
AUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_SECRET="same-or-another-long-random-string"

# Public base URL used in emails (password-reset links). Falls back to NEXTAUTH_URL.
APP_URL="http://localhost:3000"

# ── Email (password reset). Without a provider NOTHING is sent: the link is only
#    written to the server log and the UI says email is not configured. ───────
# MAIL_PROVIDER="smtp"            # smtp | resend
# MAIL_FROM="Zoir Freelance <no-reply@yourdomain.tj>"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"             # true for port 465
# SMTP_USER=""
# SMTP_PASS=""
# RESEND_API_KEY=""               # when MAIL_PROVIDER=resend

# ── Deadline reminders: GET/POST /api/cron/deadlines with "Authorization: Bearer $CRON_SECRET"
#    (endpoint returns 503 while unset). Idempotent; deduplicated per milestone/user/deadline.
# CRON_SECRET="generate-a-long-random-string"
# DEADLINE_WINDOW_HOURS="48"

# ── File storage: local | cloudinary | s3 ─────────────────────────────────────
# Render free disk is ephemeral — use cloudinary or s3 in production.
STORAGE_PROVIDER="local"
# Private files (chat, proposals, submissions) for STORAGE_PROVIDER=local; never served statically.
# PRIVATE_STORAGE_DIR="./storage/private"

# Cloudinary (STORAGE_PROVIDER=cloudinary)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=zoirfreelance

# S3-compatible (STORAGE_PROVIDER=s3) — AWS, Cloudflare R2, MinIO…
# Private files are stored without ACL and streamed via /api/files/[id] after an access check.
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# S3_PUBLIC_URL=https://cdn.example.com
# S3_ACL=public-read

# ── Testing ──────────────────────────────────────────────────────────────────
# RATE_LIMIT_DISABLED="1"         # never in production

# Database (Postgres) — required
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Auth secrets (required in production)
AUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_SECRET="same-or-another-long-random-string"

# App URL (Render sets RENDER_EXTERNAL_URL; optional locally)
# NEXT_PUBLIC_APP_URL="https://your-app.onrender.com"

# File storage: local | cloudinary | s3
# Render free disk is ephemeral — use cloudinary or s3 in production
STORAGE_PROVIDER="local"

# Cloudinary (when STORAGE_PROVIDER=cloudinary)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=codefreelance

# S3-compatible (when STORAGE_PROVIDER=s3) — AWS, R2, MinIO, etc.
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# S3_PUBLIC_URL=https://cdn.example.com
# S3_ACL=public-read

# Optional: seed on first deploy (set in Render shell once)
# RUN_SEED=true
